# 공개 서버(EC2)에서 실행할 때 이 파일을 .env로 복사하고 값을 새로 만드세요.
#   cp .env.example .env
# .env는 Git에 올라가지 않습니다(.gitignore). 로컬 시연은 .env 없이도 됩니다.
#
# 키 만들기(32바이트 Base64, 실행할 때마다 다른 값이 나옵니다):
#   openssl rand -base64 32
#   또는 docker run --rm alpine sh -c "head -c 32 /dev/urandom | base64"
#
# 주의: DB_PASSWORD와 두 이메일 키는 처음 실행한 뒤에 바꾸면 안 됩니다.
#   - DB_PASSWORD: PostgreSQL은 볼륨을 처음 만들 때만 비밀번호를 정합니다.
#   - 이메일 키: 바꾸면 기존 회원의 이메일을 풀 수 없고 중복 확인도 어긋납니다.
#   바꿔야 한다면 docker compose down -v로 DB를 지우고 새로 시작하세요.

DB_PASSWORD=
EMAIL_ENCRYPTION_KEY=
EMAIL_LOOKUP_KEY=

# 샘플 계정 4개(햇살방·구름집·달빛집·솔바람집)의 로그인 비밀번호. 8자 이상.
# 비워 두면 구경 전용입니다. 바꾼 뒤 docker compose up -d 하면 앱이 다시 켜지며 적용됩니다.
SAMPLE_PASSWORD=

# 샘플 집을 만들지 않으려면 false
SAMPLE_DATA=true
